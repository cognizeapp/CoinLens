<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Coinsights</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>coinsight</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>NSCameraUsageDescription</key>
		<string>Coinsights uses the camera to photograph your coins so they can be identified.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Coinsights needs access to your photos so you can upload an existing picture of a coin.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Coinsights can save coin photos you capture to your photo library.</string>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Coinsights only uses standard HTTPS (exempt encryption); this skips
		     the export-compliance prompt on every App Store Connect build. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- Google Sign-In redirect URL scheme — REVERSED_CLIENT_ID from
		     ios/Runner/GoogleService-Info.plist (Firebase project
		     coinsights-eabc4). Update this if the app is ever re-added to
		     Firebase with a new OAuth client. -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.776787264875-3edg7sk8pkb9sjd3m2nd3s67nd80das8</string>
				</array>
			</dict>
		</array>
		<!-- AdMob — Coinsights iOS app (AdMob publisher pub-9425660542593371). -->
		<key>GADApplicationIdentifier</key>
		<string>ca-app-pub-9425660542593371~7248254376</string>
	</dict>
</plist>
