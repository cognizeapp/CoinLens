# Normalize line endings to LF in the repo (CI runs on Linux/macOS).
* text=auto eol=lf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.p8 binary
*.p12 binary

# Shell / gradle wrappers must stay LF and executable.
gradlew text eol=lf
*.sh text eol=lf

# Windows batch files must stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
