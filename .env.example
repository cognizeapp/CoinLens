# Copy to .env and fill in. Loaded at build time via --dart-define-from-file=.env
# NEVER commit the real .env. No AI/provider keys belong in the client — they
# live only in Cloud Functions / backend env.

APP_FLAVOR=dev

# Feature flags
ENABLE_FIREBASE=false
ENABLE_REVENUECAT=false

# Backend base URL (Cloud Functions / API gateway) used by the identification
# and value-estimation services. Mock providers are used when empty.
API_BASE_URL=

# RevenueCat public SDK keys (safe for client). Backend validates receipts.
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=

# Google Gemini API key for cloud coin identification. Empty -> the on-device
# pipeline is used. Free key at https://aistudio.google.com (no card for the
# free tier); restrict it to the "Generative Language API". For a public
# release move this behind a proxy (Cloud Function).
GEMINI_API_KEY=

# Real AdMob interstitial units (create in the AdMob console). Empty -> ships
# Google's test interstitial (labelled "Test Ad", safe, never earns).
ADMOB_INTERSTITIAL_IOS=
ADMOB_INTERSTITIAL_ANDROID=
